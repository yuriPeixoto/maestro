# Copy this file to .env and fill in your values.
# .env is gitignored — never commit credentials.

# Redis (Memurai on Windows or Redis on Linux)
MAESTRO_REDIS_URL=redis://localhost:6379

# ClickHouse — use the least-privilege app user, not 'default'.
# See docs/deployment.md for the SQL commands to create maestro_app.
MAESTRO_CLICKHOUSE_HOST=localhost
MAESTRO_CLICKHOUSE_PORT=8123
MAESTRO_CLICKHOUSE_USER=maestro_app
MAESTRO_CLICKHOUSE_PASSWORD=
MAESTRO_CLICKHOUSE_DATABASE=maestro

# Auth — generate with: openssl rand -hex 32
MAESTRO_JWT_SECRET=

# SQLite user store (api/data/, gitignored).
# On a fresh install with an empty users table, one account is seeded from
# these two legacy settings (upgrade path from the old single-admin login).
# MAESTRO_ADMIN_USERNAME=
# MAESTRO_ADMIN_PASSWORD_HASH=
# MAESTRO_AUTH_DB_PATH=data/maestro_auth.db
# MAESTRO_FRONTEND_URL=http://localhost:5173  # used to build password-reset email links

# ML models directory; must be writable by the API
# MAESTRO_ML_MODELS_DIR=/opt/maestro/models

# SMTP — used by email alerts and "forgot password"
# MAESTRO_SMTP_HOST=
# MAESTRO_SMTP_PORT=587
# MAESTRO_SMTP_USER=
# MAESTRO_SMTP_PASSWORD=
# MAESTRO_SMTP_FROM=maestro@localhost
# MAESTRO_SMTP_TLS=true

# Optional tuning (defaults shown)
# MAESTRO_OFFLINE_THRESHOLD_SECONDS=90
# MAESTRO_CONSUMER_BATCH_SIZE=1000
# MAESTRO_CONSUMER_FLUSH_INTERVAL_MS=5000
# MAESTRO_CLICKHOUSE_POOL_SIZE=10
