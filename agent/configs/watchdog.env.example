# Maestro watchdog — copy to /etc/maestro/watchdog.env and chmod 600 (it holds the bot token).
# See docs/watchdog.md.

# name=url pairs separated by commas
WATCHDOG_TARGETS=Maestro=https://maestro.example.com/api/health

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional (defaults shown)
# WATCHDOG_INTERVAL=1m
# WATCHDOG_TIMEOUT=10s
# WATCHDOG_FAILURES=3
# WATCHDOG_REMIND=1h
# WATCHDOG_LANGUAGE=pt-BR
# WATCHDOG_ANNOUNCE=true
