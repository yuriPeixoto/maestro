# /etc/systemd/system/maestro-watchdog.service — see docs/watchdog.md
[Unit]
Description=Maestro watchdog
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/maestro/watchdog.env
ExecStart=/usr/local/bin/maestro-watchdog
Restart=always
RestartSec=10
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
